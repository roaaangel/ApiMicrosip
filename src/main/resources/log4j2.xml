<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">

    <Properties>
        <Property name="LOG_PATTERN">%d{yyyy-MM-dd HH:mm:ss} %-5p %c{1}:%L - %m%n</Property>
        <Property name="LOG_DIR">C:/logs</Property>
        <Property name="LOG_FILE">log_app_android</Property>
    </Properties>

    <Appenders>

        <!-- Salida por consola -->
        <Console name="stdout" target="SYSTEM_OUT">
            <PatternLayout pattern="${LOG_PATTERN}"/>
        </Console>

        <!-- Salida por archivo con rotación por tamaño -->
        <RollingFile name="file"
                     fileName="${LOG_DIR}/${LOG_FILE}.log"
                     filePattern="${LOG_DIR}/${LOG_FILE}-%i.log.gz">
            <PatternLayout pattern="${LOG_PATTERN}"/>
            <Policies>
                <SizeBasedTriggeringPolicy size="5MB"/>
            </Policies>
            <DefaultRolloverStrategy max="10"/>
        </RollingFile>

    </Appenders>

    <Loggers>

        <!-- Logger raíz: aplica a toda la aplicación -->
        <Root level="INFO">
            <AppenderRef ref="file"/>
            <AppenderRef ref="stdout"/>
        </Root>

    </Loggers>

</Configuration>